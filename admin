            const rekapKualEl = document.getElementById("dash-rekap-kualifikasi");
            const entriKual = Object.entries(mapKual).sort((a, b) => b[1] - a[1]);
            rekapKualEl.innerHTML = entriKual.length === 0
                ? `<p class="text-xs text-slate-400 text-center py-6">Belum ada data kualifikasi.</p>`
