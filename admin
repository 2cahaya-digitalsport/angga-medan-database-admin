                if (k.tipe === "pemasukan") totalMasuk += nom;
                else totalKeluar += nom;
            });

            document.getElementById("kas-saldo").innerText = formatRupiah(totalMasuk - totalKeluar);
            document.getElementById("kas-masuk").innerText = "+ " + formatRupiah(totalMasuk);
            document.getElementById("kas-keluar").innerText = "- " + formatRupiah(totalKeluar);

