            }).join("");

            container.className = "px-4 py-3 border-t border-slate-100 bg-slate-50/60 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-xs";
            container.innerHTML = `
                <p class="text-[11px] text-slate-500 font-medium">
                    Menampilkan <b class="text-slate-700">${startIdx + 1}–${endIdx}</b> dari <b class="text-slate-700">${total}</b> data
