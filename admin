            const id = idLama || String(Date.now());
            const sumberNode = document.getElementById("ps-sumber-node").value || "persetujuan_admin";
            const existing = dataPersetujuan.find(a => String(a.id) === String(idLama));
            const foto = await prosesFileInput("ps-foto", existing ? (existing.foto || "") : "");
            const statusSaatIni = existing ? (existing.status || "Menunggu") : "Menunggu";

            const payload = {
                id: id,
                nama_lengkap: document.getElementById("ps-nama").value.trim(),
                nia: document.getElementById("ps-nia").value.trim(),
                ranting_rayon: document.getElementById("ps-rayon").value.trim(),
