        // Helper Pagination Otomatis
        function paginateData(menu, list) {
            const total = list.length;
            const totalPages = Math.max(1, Math.ceil(total / ITEMS_PER_PAGE));
            let page = paginationState[menu] || 1;
            if (page > totalPages) page = totalPages;
            if (page < 1) page = 1;
            paginationState[menu] = page;

            const startIdx = (page - 1) * ITEMS_PER_PAGE;
            const endIdx = Math.min(startIdx + ITEMS_PER_PAGE, total);
            const paged = list.slice(startIdx, endIdx);

            renderPaginationControls(menu, page, totalPages, startIdx, endIdx, total);
            return { paged, startIdx };
        }

        function renderPaginationControls(menu, page, totalPages, startIdx, endIdx, total) {
            const container = document.getElementById("pagination-" + menu);
            if (!container) return;

            if (total === 0) {
                container.classList.add("hidden");
                container.innerHTML = "";
                return;
            }

            const pages = [];
            if (totalPages <= 5) {
                for (let i = 1; i <= totalPages; i++) pages.push(i);
            } else {
                pages.push(1);
                if (page > 3) pages.push("...");
                const start = Math.max(2, page - 1);
                const end = Math.min(totalPages - 1, page + 1);
                for (let i = start; i <= end; i++) pages.push(i);
                if (page < totalPages - 2) pages.push("...");
                pages.push(totalPages);
            }

            const pageButtons = pages.map(p => {
