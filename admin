            if (!item) return;

            const payload = { ...item };
            const sumber = payload._sumberNode || "persetujuan_admin";
            delete payload._sumberNode;
            payload.status = "Dikonfirmasi";

            try {
                const updates = {};
                updates[`administrasi_digital/anggota/${id}`] = payload;
                if (sumber === "persetujuan_admin") {
                    updates[`administrasi_digital/persetujuan_admin/${id}`] = payload;
                }
                await database.ref().update(updates);
                tampilkanNotif(`${item.nama_lengkap || "Peserta"} dikonfirmasi & masuk ke Data Peserta.`);
            } catch (e) {
                tampilkanNotif("Gagal mengonfirmasi: " + e.message, true);
            }
        }

