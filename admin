        // Firebase Realtime Listeners
        function aktifkanRealtimeData() {
            if (listenersAktif) return;
            listenersAktif = true;

            database.ref("administrasi_digital/anggota").on("value", snap => {
                const val = snap.val();
                rawAnggotaList = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                gabungkanDataPeserta();
            });

            database.ref("administrasi_digital/persetujuan_admin").on("value", snap => {
                const val = snap.val();
                rawPersetujuanList = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                gabungkanDataPeserta();
            });

            database.ref("administrasi_digital/absensi").on("value", snap => {
                const val = snap.val();
                dataAbsensi = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                dataAbsensi.sort((a, b) => new Date(b.tanggal || 0) - new Date(a.tanggal || 0));
                renderDashboard();
                renderAbsensi();
            });

            database.ref("administrasi_digital/rayon").on("value", snap => {
                const val = snap.val();
                dataRayon = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
