                if (!mapRayon[rName]) mapRayon[rName] = { total: 0, putra: 0, putri: 0 };
                mapRayon[rName].total++;
                if (g === "putra") mapRayon[rName].putra++;
                if (g === "putri") mapRayon[rName].putri++;

