            const filtered = dataKeuangan.filter(item => {
                const matchBulan = !filterBulan || String(item.tanggal || "").startsWith(filterBulan);
                const matchTipe = !filterTipe || item.tipe === filterTipe;
                const matchCari = (item.keterangan || "").toLowerCase().includes(kueri) || (item.tanggal || "").includes(kueri);
