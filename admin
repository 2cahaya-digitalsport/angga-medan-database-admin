                sinkronOpsiRayon();
                renderDashboard();
                renderJadwal();
            });

            database.ref("administrasi_digital/keuangan").on("value", snap => {
                const val = snap.val();
                dataKeuangan = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                dataKeuangan.sort((a, b) => {
                    const diff = new Date(b.tanggal || 0) - new Date(a.tanggal || 0);
                    if (diff !== 0) return diff;
                    return String(b.id || "").localeCompare(String(a.id || ""));
                });
                renderDashboard();
                renderKas();
            });

            database.ref("administrasi_digital/kas_anggota").on("value", snap => {
                const val = snap.val();
                dataKasAnggota = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                dataKasAnggota.sort((a, b) => {
                    const diff = new Date(b.tanggal || 0) - new Date(a.tanggal || 0);
                    if (diff !== 0) return diff;
                    return String(b.id || "").localeCompare(String(a.id || ""));
                });
                renderDashboard();
                renderKasAnggota();
